{
  "compatibility_date": "2025-04-19",
  "main": "src/index.ts",
  "name": "al-ummah-now-profile-qa",
  "upload_source_maps": true,
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "AUTH_STORAGE",
      "id": "14fd32ab385b496c88b5dba88c2492ea"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "al-ummah-now-d1-qa",
      "database_id": "28590f3c-dd92-4c26-a803-d73a9bbe2b58"
    }
  ],
  "vars": {
    "AUTH_SERVER_URL": "https://auth.qa.alummahnow.net",
    "APP_URL": "https://profile.auth.qa.alummahnow.net",
    "APP_ENV": "qa",
    "CF_WEB_ANALYTICS_TOKEN": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "routes": [
    {
      "pattern": "profile.auth.qa.alummahnow.net",
      "zone_name": "alummahnow.net",
      "custom_domain": true
    },
    {
      "pattern": "account.qa.alummahnow.net",
      "zone_name": "alummahnow.net",
      "custom_domain": true
    }
  ],
  "compatibility_flags": ["nodejs_compat"]
}
