{
  "name": "profile",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now User Profile Application",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 3302 --inspector-port 3312",
    "deploy": "wrangler deploy",
    "deploy:qa": "wrangler deploy --config wrangler.qa.json",
    "deploy:stage": "wrangler deploy --env stage",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@al-ummah-now/openauth": "1.0.19-pr.15.139",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.11",
    "@cloudflare/workers-types": "^4.20251128.0",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.51.0"
  }
}
