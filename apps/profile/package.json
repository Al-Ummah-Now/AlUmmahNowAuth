{
  "name": "profile",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now User Profile Application",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev -c wrangler.dev.json --port 3302 --inspector-port 3312",
    "deploy": "wrangler deploy",
    "deploy:qa": "wrangler deploy --config wrangler.qa.json",
    "deploy:stage": "wrangler deploy --env stage",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "types": "wrangler types --env-file .dev.vars.example --strict-vars=false"
  },
  "dependencies": {
    "@al-ummah-now/openauth": "1.2.2",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "~4.166.0"
  }
}
