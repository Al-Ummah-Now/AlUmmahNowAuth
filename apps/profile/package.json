{
  "name": "profile",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now User Profile Application",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 3302 --inspector-port 3312",
    "deploy": "wrangler deploy",
    "deploy:qa": "wrangler deploy --config wrangler.qa.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@al-ummah-now/openauth": "1.0.15",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.2",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.108.0"
  }
}
