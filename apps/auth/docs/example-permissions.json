  "policies": [
    {
      "id": "policy_mfa_required",
      "name": "MFA Required for Dangerous Operations",
      "description": "Require multi-factor authentication for dangerous permissions",
      "type": "mfa_required",
      "applies_to": {
        "permissions": [
          "*:*:*",
          "users:impersonate:all",
          "audit:delete:all",
          "system:manage:all",
          "settings:manage:all"
        ]
      },
      "enforcement": "strict"
    },
    {
      "id": "policy_time_based",
      "name": "Business Hours Only",
      "description": "Certain operations only allowed during business hours",
      "type": "time_based",
      "applies_to": {
        "permissions": [
          "users:delete:all",
          "system:backup:all"
        ]
      },
      "conditions": {
        "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
        "hours": {
          "start": "09:00",
          "end": "17:00"
        },
        "timezone": "UTC"
      }
    },
    {
      "id": "policy_approval_required",
      "name": "Approval Required",
      "description": "Require approval for critical operations",
      "type": "approval_required",
      "applies_to": {
        "permissions": [
          "users:delete:all",
          "roles:delete:all",
          "audit:delete:all"
        ]
      },
      "conditions": {
        "approvers": ["role:admin", "role:super_admin"],
        "minimum_approvals": 1,
        "approval_timeout_hours": 24
      }
    },
    {
      "id": "policy_rate_limit",
      "name": "Rate Limiting",
      "description": "Limit frequency of certain operations",
      "type": "rate_limit",
      "applies_to": {
        "permissions": [
          "users:create:all",
          "content:create:all"
        ]
      },
      "conditions": {
        "max_per_hour": 100,
        "max_per_day": 1000
      }
    }
  ],
