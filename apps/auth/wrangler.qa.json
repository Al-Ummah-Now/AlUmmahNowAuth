{
  "compatibility_date": "2024-12-30",
  "main": "src/index.ts",
  "name": "al-ummah-now-auth-qa",
  "upload_source_maps": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "auth.qa.alummahnow.net",
      "zone_name": "alummahnow.net",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_STORAGE",
      "id": "14fd32ab385b496c88b5dba88c2492ea"
    },
    {
      "binding": "TOKEN_REVOCATIONS",
      "id": "e6e662fc9cd9420797ddfa8060eb6956"
    },
    {
      "binding": "AUTH_THEMES",
      "id": "1de119003c134f37b222897f3bcec0cb"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "al-ummah-now-d1-qa",
      "database_id": "28590f3c-dd92-4c26-a803-d73a9bbe2b58",
      "migrations_dir": "migrations-qa"
    }
  ],
  "ratelimits": [
    { "name": "TOKEN_LIMITER", "namespace_id": "3303", "simple": { "limit": 600, "period": 60 } },
    { "name": "TOKEN_CLIENT_LIMITER", "namespace_id": "3304", "simple": { "limit": 3000, "period": 60 } },
    { "name": "SEND_CODE_LIMITER", "namespace_id": "3305", "simple": { "limit": 100, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "3306", "simple": { "limit": 600, "period": 60 } },
    { "name": "ADMIN_SENSITIVE_LIMITER", "namespace_id": "3307", "simple": { "limit": 100, "period": 60 } },
    { "name": "PASSWORD_IP_LIMITER", "namespace_id": "3301", "simple": { "limit": 100, "period": 60 } },
    { "name": "PASSWORD_EMAIL_LIMITER", "namespace_id": "3302", "simple": { "limit": 10, "period": 60 } },
    { "name": "NATIVE_PASSKEY_LIMITER", "namespace_id": "3308", "simple": { "limit": 30, "period": 60 } }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUDIT_QUEUE",
        "queue": "audit-events-qa"
      },
      { "binding": "MODERATION_QUEUE", "queue": "moderation-actions-qa" }
    ],
    "consumers": [
      { "queue": "moderation-actions-qa", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 6, "retry_delay": 30, "dead_letter_queue": "moderation-actions-qa-dlq" },
      { "queue": "moderation-actions-qa-dlq", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  "vars": {
    "ERRORS_INGEST_URL": "https://admin.api.qa.alummahnow.net/internal/errors",
    "ENVIRONMENT": "qa",
    "PASSKEY_PROMPT": "on",
    "ANDROID_APP_CERTS": "{\"net.alummahnow.studio.qa\": [\"5A:1B:3D:2B:57:6E:9A:2D:F0:BF:1B:E3:F1:8C:40:20:13:F9:5C:09:EA:EE:7C:F7:31:10:C4:2F:B5:69:DD:C0\"]}",
    "TURNSTILE_MODE": "enforce",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "AUDIT_SAMPLE": "auth.login.success=0.1,admin.item.*=0.1",
    "LOG_LEVEL": "warn",
    "E2E_RUN_USERS": "enabled",
    "PROFILE_APP_URL": "https://profile.auth.qa.alummahnow.net/",
    "PROFILE_CLIENT_ID": "109a1087-6626-40f7-8a7f-7f42f83f4f30",
    "ALLOWED_ORIGINS": "*.qa.alummahnow.net,https://profile.auth.qa.alummahnow.net,https://admin.auth.qa.alummahnow.net",
    "OPENAUTH_ISSUER": "https://auth.qa.alummahnow.net",
    "SITES_CLIENT_ID": "0abd9eac-e47e-4a1a-90bd-18cffec0303c",
    "SITES_REGISTRY_URL": "https://videos.api.qa.alummahnow.net",
    "ACCESS_TOKEN_TTL": "900",
    "AUDIT_WEBHOOK_URL": "",
    "AUDIT_WEBHOOK_SECRET": "",
    "SIGN_IN_FALLBACK_URL": "https://videos.qa.alummahnow.net/",
    "FRONTCHANNEL_LOGOUT_URLS": "https://profile.auth.qa.alummahnow.net/logout,https://admin.auth.qa.alummahnow.net/logout,https://videos.qa.alummahnow.net/api/auth/logout,https://admin.qa.alummahnow.net/api/auth/logout,https://www.qa.alummahnow.net/auth/logout,https://cms.qa.alummahnow.net/sso/logout",
    "CLIENT_REGISTRY_MODE": "enforce",
    "PREVIEW_WEB_CLIENT_ID": "e0de3c30-0304-4ac4-86d6-1e185dec0439",
    "PREVIEW_WORKERS_SUBDOMAIN": "mahmoud-s-darwish"
  },
  "triggers": {
    "crons": [
      "0 * * * *",
      "*/10 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  },
  "logpush": false,
  "analytics_engine_datasets": [
    {
      "binding": "AUTH_ANALYTICS",
      "dataset": "auth_events_qa"
    },
    { "binding": "ABUSE_EVENTS", "dataset": "al_ummah_now_abuse_qa" }
  ],
  "secrets_store_secrets": [
    { "binding": "BOT_BYPASS_SECRET", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "bot-bypass-secret-nonprod" },
    { "binding": "TURNSTILE_SECRET", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "turnstile-secret-test" },
    {
      "binding": "INTERNAL_API_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "internal-api-key-qa"
    },
    {
      "binding": "CLIENT_SECRET_SALT",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "CLIENT_SECRET_SALT_QA"
    },
    {
      "binding": "KEY_ENCRYPTION_MASTER_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "KEY_ENCRYPTION_MASTER_KEY_QA"
    },
    {
      "binding": "RESEND_API_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "RESEND_API_KEY"
    },
    {
      "binding": "E2E_CODE_SINK_SECRET",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "E2E_CODE_SINK_SECRET_QA"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "tail_consumers": []
}
