{
  "name": "auth",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now OpenAuth Server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 3301 --inspector-port 3311",
    "dev:remote": "wrangler dev --port 3301 --inspector-port 3311 --remote",
    "dev:inspect": "wrangler dev --inspector",
    "tail": "wrangler tail --format pretty",
    "deploy": "wrangler deploy --env production",
    "deploy:qa": "wrangler deploy --config wrangler.qa.json",
    "deploy:stage": "wrangler deploy --env stage",
    "predeploy": "npx openauth migrate AUTH_DB --remote --withSeed && wrangler d1 migrations apply AUTH_DB --remote && npx openauth bootstrap-secrets AUTH_DB --remote",
    "predeploy:qa": "npx openauth migrate AUTH_DB -c wrangler.qa.json --remote --withSeed && wrangler -c wrangler.qa.json d1 migrations apply AUTH_DB --remote && npx openauth bootstrap-secrets AUTH_DB -c wrangler.qa.json --remote",
    "migrations:local": "npx openauth migrate AUTH_DB --local --withSeed && wrangler d1 migrations apply AUTH_DB --local && npx openauth bootstrap-secrets AUTH_DB --local",
    "migrations:local:openauth": "npx openauth migrate AUTH_DB --local --withSeed",
    "migrations:local:app": "wrangler d1 migrations apply AUTH_DB --local",
    "migrations:local:secrets": "npx openauth bootstrap-secrets AUTH_DB --local",
    "migrations:remote": "npx openauth migrate AUTH_DB --remote --withSeed && wrangler d1 migrations apply AUTH_DB --remote && npx openauth bootstrap-secrets AUTH_DB --remote",
    "migrations:remote:openauth": "npx openauth migrate AUTH_DB --remote --withSeed",
    "migrations:remote:app": "wrangler d1 migrations apply AUTH_DB --remote",
    "migrations:remote:secrets": "npx openauth bootstrap-secrets AUTH_DB --remote",
    "migrations:qa": "npx openauth migrate AUTH_DB -c wrangler.qa.json --remote --withSeed && wrangler -c wrangler.qa.json d1 migrations apply AUTH_DB --remote && npx openauth bootstrap-secrets AUTH_DB -c wrangler.qa.json --remote",
    "migrations:qa:openauth": "npx openauth migrate AUTH_DB -c wrangler.qa.json --remote --withSeed",
    "migrations:qa:app": "wrangler -c wrangler.qa.json d1 migrations apply AUTH_DB --remote",
    "migrations:qa:secrets": "npx openauth bootstrap-secrets AUTH_DB -c wrangler.qa.json --remote",
    "migrations:preview": "npx openauth migrate AUTH_DB --preview --withSeed && wrangler d1 migrations apply AUTH_DB --remote && npx openauth bootstrap-secrets AUTH_DB --preview",
    "migrations:preview:openauth": "npx openauth migrate AUTH_DB --preview --withSeed",
    "migrations:preview:app": "wrangler d1 migrations apply AUTH_DB --remote",
    "migrations:preview:secrets": "npx openauth bootstrap-secrets AUTH_DB --preview",
    "seed:local": "wrangler d1 execute AUTH_DB --local --file=./migrations/0004_seed_data.sql",
    "seed:preview": "wrangler d1 execute AUTH_DB --remote --file=./migrations/0004_seed_data.sql",
    "seed:qa": "wrangler d1 execute AUTH_DB -c wrangler.qa.json --remote --file=./migrations-qa/0004_seed_data.sql",
    "seed:remote": "wrangler d1 execute AUTH_DB --env production --remote --file=./migrations/0004_seed_data.sql",
    "seed:roles:local": "wrangler d1 execute AUTH_DB --local --file=./scripts/seed-openauth-roles.sql",
    "seed:roles:qa": "wrangler d1 execute AUTH_DB -c wrangler.qa.json --remote --file=./scripts/seed-openauth-roles.sql",
    "seed:roles:remote": "wrangler d1 execute AUTH_DB --env production --remote --file=./scripts/seed-openauth-roles.sql",
    "fix:tenant:local": "wrangler d1 execute AUTH_DB --local --file=./scripts/fix-oauth-client-tenant.sql",
    "fix:tenant:qa": "wrangler d1 execute AUTH_DB -c wrangler.qa.json --remote --file=./scripts/fix-oauth-client-tenant.sql",
    "fix:tenant:remote": "wrangler d1 execute AUTH_DB --env production --remote --file=./scripts/fix-oauth-client-tenant.sql",
    "types": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@al-ummah-now/openauth": "1.0.19-pr.15.139",
    "@types/node": "^24.10.1",
    "jose": "^6.1.0",
    "resend": "^6.5.2",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.11",
    "@cloudflare/workers-types": "^4.20251128.0",
    "@vitest/coverage-v8": "^3.2.0",
    "hono": "^4.13.16",
    "typescript": "5.9.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.3"
  }
}
