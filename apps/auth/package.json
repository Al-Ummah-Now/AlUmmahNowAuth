{
  "name": "auth",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now OpenAuth Server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to=../../.wrangler/state",
    "dev:inspect": "wrangler dev --inspector --persist-to=../../.wrangler/state",
    "tail": "wrangler tail --format pretty",
    "deploy": "wrangler deploy",
    "predeploy": "wrangler d1 migrations apply AUTH_DB --remote",
    "migrations:local": "wrangler d1 migrations apply AUTH_DB --local --persist-to=../../.wrangler/state",
    "migrations:remote": "wrangler d1 migrations apply AUTH_DB --remote",
    "types": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@openauthjs/openauth": "0.4.3",
    "@types/node": "^24.9.1",
    "resend": "^6.2.2",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.0",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.43.0"
  }
}
