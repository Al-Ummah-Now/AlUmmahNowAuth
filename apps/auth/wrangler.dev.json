{
  "name": "al-ummah-now-auth-dev",
  "compatibility_date": "2024-12-30",
  "main": "src/index.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_STORAGE",
      "id": "local-auth-storage"
    },
    {
      "binding": "TOKEN_REVOCATIONS",
      "id": "local-token-revocations"
    },
    {
      "binding": "AUTH_THEMES",
      "id": "local-auth-themes"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "al-ummah-now-d1-local",
      "database_id": "local-auth-db",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "TOKEN_LIMITER",
      "namespace_id": "3003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "TOKEN_CLIENT_LIMITER",
      "namespace_id": "3004",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    },
    {
      "name": "SEND_CODE_LIMITER",
      "namespace_id": "3005",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LIMITER",
      "namespace_id": "3006",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "ADMIN_SENSITIVE_LIMITER",
      "namespace_id": "3007",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PASSWORD_IP_LIMITER",
      "namespace_id": "3001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "PASSWORD_EMAIL_LIMITER",
      "namespace_id": "3002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "NATIVE_PASSKEY_LIMITER",
      "namespace_id": "3008",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "BIRTH_DATE_LIMITER",
      "namespace_id": "3009",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "ACCOUNT_DELETION_LIMITER",
      "namespace_id": "3010",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUDIT_QUEUE",
        "queue": "audit-events"
      },
      {
        "binding": "MODERATION_QUEUE",
        "queue": "moderation-actions-dev"
      },
      {
        "binding": "ACCOUNT_EVENTS_QUEUE",
        "queue": "account-events-dev"
      }
    ],
    "consumers": [
      {
        "queue": "moderation-actions-dev",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "retry_delay": 30,
        "dead_letter_queue": "moderation-actions-dev-dlq"
      },
      {
        "queue": "moderation-actions-dev-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "account-events-dev",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "retry_delay": 30,
        "dead_letter_queue": "account-events-dev-dlq"
      },
      {
        "queue": "account-events-dev-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "vars": {
    "SIGNING_KEY_ROTATION_SCHEDULE": "on",
    "ENVIRONMENT": "development",
    "PASSKEY_PROMPT": "off",
    "TURNSTILE_MODE": "off",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
    "PROFILE_APP_URL": "http://localhost:3302/",
    "PROFILE_CLIENT_ID": "109a1087-6626-40f7-8a7f-7f42f83f4f30",
    "ALLOWED_ORIGINS": "localhost,127.0.0.1",
    "OPENAUTH_ISSUER": "http://localhost:3301",
    "ACCOUNT_EVENTS": "off",
    "AUDIT_WEBHOOK_URL": "",
    "AUDIT_WEBHOOK_SECRET": "",
    "SIGN_IN_FALLBACK_URL": "http://localhost:3302/",
    "FRONTCHANNEL_LOGOUT_URLS": "http://localhost:3302/logout,http://localhost:5175/logout",
    "CLIENT_REGISTRY_MODE": "enforce"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "AUTH_ANALYTICS",
      "dataset": "auth_events"
    },
    {
      "binding": "ABUSE_EVENTS",
      "dataset": "al_ummah_now_abuse_dev"
    }
  ],
  "tail_consumers": [],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
