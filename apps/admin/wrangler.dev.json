{
  "name": "al-ummah-now-auth-admin-dev",
  "compatibility_date": "2025-04-19",
  "main": "workers/app.ts",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_SERVER_URL": "http://localhost:3301",
    "APP_URL": "http://localhost:3303",
    "ADMIN_CLIENT_ID": "1448ed27-39a6-417d-b4c8-07f881e81269",
    "LOG_LEVEL": "debug"
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_STORAGE",
      "id": "local-auth-storage"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "al-ummah-now-d1-local",
      "database_id": "local-auth-db"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ]
}
