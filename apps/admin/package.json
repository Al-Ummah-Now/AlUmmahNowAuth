{
  "name": "admin",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now Admin Dashboard",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --port 3303",
    "dev:wrangler": "wrangler dev -c wrangler.dev.json --port 5175 --local --persist-to=../../.wrangler/state",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "deploy:qa": "pnpm build && node --experimental-strip-types --no-warnings ../../scripts/release/admin-config.ts qa && wrangler deploy --config build/server/wrangler.qa.json",
    "deploy:stage": "pnpm build && node --experimental-strip-types --no-warnings ../../scripts/release/admin-config.ts stage && wrangler deploy --config build/server/wrangler.stage.json",
    "typecheck": "react-router typegen && tsc",
    "type-check": "react-router typegen && tsc",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "types": "wrangler types --env-file .dev.vars.example --strict-vars=false"
  },
  "dependencies": {
    "@al-ummah-now/openauth": "1.2.2",
    "@al-ummah-now/ui": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@react-router/node": "^8.5.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "isbot": "^5.2.3",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.70.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "~4.164.0"
  }
}
