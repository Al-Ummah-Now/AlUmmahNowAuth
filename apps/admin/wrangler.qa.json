{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2025-04-19",
  "name": "al-ummah-now-auth-admin-qa",
  "main": "build/server/index.js",
  "no_bundle": true,
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_SERVER_URL": "https://auth.qa.alummahnow.net",
    "APP_URL": "https://admin.auth.qa.alummahnow.net",
    "ADMIN_CLIENT_ID": "admin-dashboard-m2m"
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_STORAGE",
      "id": "14fd32ab385b496c88b5dba88c2492ea"
    }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"]
}
