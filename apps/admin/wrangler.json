{
  "compatibility_date": "2025-04-19",
  "name": "al-ummah-now-auth-admin",
  "workers_dev": true,
  "main": "workers/app.ts",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_SERVER_URL": "https://auth.alummahnow.net",
    "APP_URL": "https://admin.auth.alummahnow.net",
    "ADMIN_CLIENT_ID": "1448ed27-39a6-417d-b4c8-07f881e81269"
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_STORAGE",
      "id": "c3f796d40db8420c920aef1ce10a7f13",
      "preview_id": "c9f1b1f1492e4a61b5e20d1872aa14fb",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "al-ummah-now-d1",
      "database_id": "af76f007-e21e-43aa-88de-ebfefe46fb56"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  },
  "routes": [
    {
      "pattern": "admin.auth.alummahnow.net",
      "zone_name": "alummahnow.net",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "env": {
    "stage": {
      "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "head_sampling_rate": 0.1 } },
      "name": "al-ummah-now-auth-admin-stage",
      "routes": [
        {
          "pattern": "admin.auth.stage.alummahnow.net",
          "zone_name": "alummahnow.net",
          "custom_domain": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_STORAGE",
          "id": "72435739e09d455db7f80820b0eab79c"
        }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "al-ummah-now-d1-stage",
          "database_id": "c7886ef6-c70b-4b7f-a65b-3df9f9aba9e2"
        }
      ],
      "vars": {
        "AUTH_SERVER_URL": "https://auth.stage.alummahnow.net",
        "APP_URL": "https://admin.auth.stage.alummahnow.net",
        "ADMIN_CLIENT_ID": "1448ed27-39a6-417d-b4c8-07f881e81269"
      }
    }
  }
}
