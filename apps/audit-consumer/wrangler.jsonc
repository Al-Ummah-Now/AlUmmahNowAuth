{
  "name": "al-ummah-now-audit-consumer",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-11",
  "workers_dev": true,

  // D1 Database binding for audit logs
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "al-ummah-now-d1",
      "database_id": "af76f007-e21e-43aa-88de-ebfefe46fb56",
      "preview_database_id": "af76f007-e21e-43aa-88de-ebfefe46fb56"
    }
  ],

  // Queue consumer configuration
  "queues": {
    "consumers": [
      {
        "queue": "audit-events",
        "max_batch_size": 50, // Process up to 50 events per batch
        "max_batch_timeout": 5, // Wait max 5 seconds before processing batch
        "max_retries": 3, // Retry failed batches up to 3 times
        "dead_letter_queue": "audit-events-dlq" // Failed messages go here after max retries
      }
    ]
  },

  // Observability
  "observability": {
    "enabled": true,
    // Low traffic: keep every invocation. Lower this when traffic grows.
    "head_sampling_rate": 1
  },

  // Stage (release pipeline): consumes the stage auth worker's audit queue
  "env": {
    "stage": {
      // Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "name": "al-ummah-now-audit-consumer-stage",
      "d1_databases": [
        {
          "binding": "AUDIT_DB",
          "database_name": "al-ummah-now-d1-stage",
          "database_id": "c7886ef6-c70b-4b7f-a65b-3df9f9aba9e2"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "audit-events-stage",
            "max_batch_size": 50,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "audit-events-stage-dlq"
          }
        ]
      }
    }
  }
}
