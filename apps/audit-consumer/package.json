{
  "name": "audit-consumer",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now Audit Event Consumer - Processes audit events from queue",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev -c wrangler.dev.jsonc --port 3304",
    "deploy": "wrangler deploy",
    "deploy:qa": "wrangler deploy --config wrangler.qa.jsonc",
    "deploy:stage": "wrangler deploy --env stage",
    "types": "wrangler types --env-file .dev.vars.example --strict-vars=false",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@al-ummah-now/openauth": "1.0.63",
    "@types/node": "^26.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "~4.164.0"
  }
}
