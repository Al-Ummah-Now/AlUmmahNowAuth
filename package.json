{
  "name": "al-ummah-now-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now Authentication and Admin System",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:auth": "pnpm --filter auth dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:profile": "pnpm --filter profile dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "build:auth": "pnpm --filter auth build",
    "build:admin": "pnpm --filter admin build",
    "build:profile": "pnpm --filter profile build",
    "deploy:all": "pnpm run deploy:auth && pnpm run deploy:admin && pnpm run deploy:profile",
    "deploy:auth": "pnpm --filter auth run deploy",
    "deploy:admin": "pnpm --filter admin run deploy",
    "deploy:profile": "pnpm --filter profile run deploy",
    "type-check": "pnpm --filter \"./apps/*\" type-check",
    "test": "pnpm --filter \"./apps/*\" test",
    "test:unit": "pnpm --filter \"./apps/*\" test:unit",
    "test:watch": "pnpm --filter \"./apps/*\" test:watch",
    "test:coverage": "pnpm --filter \"./apps/*\" test:coverage"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.12",
    "@cloudflare/workers-types": "^4.20251011.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
