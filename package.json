{
  "name": "al-ummah-now-workspace",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Al Ummah Now Authentication and Admin System",
  "scripts": {
    "types": "pnpm --parallel --filter \"./apps/*\" types",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:remote": "pnpm --parallel --filter auth run dev:remote & pnpm --parallel --filter admin --filter profile --filter audit-consumer run dev",
    "dev:auth": "pnpm --filter auth dev",
    "dev:auth:remote": "pnpm --filter auth dev:remote",
    "dev:admin": "pnpm --filter admin dev",
    "dev:profile": "pnpm --filter profile dev",
    "dev:consumer": "pnpm --filter audit-consumer dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "build:auth": "pnpm --filter auth build",
    "build:admin": "pnpm --filter admin build",
    "build:profile": "pnpm --filter profile build",
    "build:consumer": "pnpm --filter audit-consumer build",
    "deploy:all": "pnpm run deploy:auth && pnpm run deploy:admin && pnpm run deploy:profile && pnpm run deploy:consumer",
    "deploy:auth": "pnpm --filter auth run deploy",
    "deploy:admin": "pnpm --filter admin run deploy",
    "deploy:profile": "pnpm --filter profile run deploy",
    "deploy:consumer": "pnpm --filter audit-consumer run deploy",
    "deploy:qa": "pnpm run deploy:qa:auth && pnpm run deploy:qa:admin && pnpm run deploy:qa:profile && pnpm run deploy:qa:consumer",
    "deploy:qa:auth": "pnpm --filter auth run deploy:qa",
    "deploy:qa:admin": "pnpm --filter admin run deploy:qa",
    "deploy:qa:profile": "pnpm --filter profile run deploy:qa",
    "deploy:qa:consumer": "pnpm --filter audit-consumer run deploy:qa",
    "deploy:stage": "pnpm run stage:seed && pnpm run deploy:stage:auth && pnpm run deploy:stage:admin && pnpm run deploy:stage:profile && pnpm run deploy:stage:consumer",
    "deploy:stage:auth": "pnpm --filter auth run deploy:stage",
    "deploy:stage:admin": "pnpm --filter admin run deploy:stage",
    "deploy:stage:profile": "pnpm --filter profile run deploy:stage",
    "deploy:stage:consumer": "pnpm --filter audit-consumer run deploy:stage",
    "stage:seed": "node --experimental-strip-types --no-warnings scripts/stage/seed.ts",
    "migrations:local": "pnpm --filter auth run migrations:local",
    "migrations:remote": "pnpm --filter auth run migrations:remote",
    "migrations:qa": "pnpm --filter auth run migrations:qa",
    "migrations:preview": "pnpm --filter auth run migrations:preview",
    "seed:local": "pnpm --filter auth run seed:local",
    "seed:preview": "pnpm --filter auth run seed:preview",
    "seed:qa": "pnpm --filter auth run seed:qa",
    "seed:remote": "pnpm --filter auth run seed:remote",
    "secrets:local": "pnpm --filter auth run migrations:local:secrets",
    "secrets:preview": "pnpm --filter auth run migrations:preview:secrets",
    "secrets:qa": "pnpm --filter auth run migrations:qa:secrets",
    "secrets:remote": "pnpm --filter auth run migrations:remote:secrets",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "pnpm --filter \"./apps/*\" type-check",
    "test": "pnpm --filter \"./apps/*\" test",
    "test:unit": "pnpm --filter \"./apps/*\" test:unit",
    "test:watch": "pnpm --filter \"./apps/*\" test:watch",
    "test:coverage": "pnpm --filter \"./apps/*\" test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report e2e-report",
    "test:scripts": "vitest run --dir scripts",
    "check:config": "node --experimental-strip-types --no-warnings scripts/release/check-wrangler-config.ts",
    "check:migrations": "node --experimental-strip-types --no-warnings scripts/release/migration-guard.ts",
    "schema:snapshot": "node --experimental-strip-types --no-warnings scripts/release/schema-snapshot.ts --write",
    "check:schema": "node --experimental-strip-types --no-warnings scripts/release/schema-snapshot.ts --check",
    "themes:build": "node --experimental-strip-types --no-warnings scripts/themes/build.ts",
    "themes:check": "node --experimental-strip-types --no-warnings scripts/themes/build.ts --check && node --experimental-strip-types --no-warnings scripts/themes/sync-fanous-street.ts --check",
    "street:sync": "node --experimental-strip-types --no-warnings scripts/themes/sync-fanous-street.ts",
    "nav:sync": "node --experimental-strip-types --no-warnings scripts/themes/sync-nav.ts",
    "nav:check": "node --experimental-strip-types --no-warnings scripts/themes/sync-nav.ts --check",
    "check:secrets": "node --experimental-strip-types --no-warnings scripts/release/check-secrets.ts",
    "secrets:rotate-client": "node --experimental-strip-types --no-warnings scripts/release/rotate-client-secret.ts",
    "secrets:seed": "node --experimental-strip-types --no-warnings scripts/release/seed-worker-secret.ts",
    "smoke": "node --experimental-strip-types --no-warnings scripts/release/smoke.ts",
    "release:promote": "node --experimental-strip-types --no-warnings scripts/release/promote.ts",
    "release:rollback": "node --experimental-strip-types --no-warnings scripts/release/rollback.ts",
    "db:migrate": "node --experimental-strip-types --no-warnings scripts/release/d1-migrate.ts",
    "check:committed-secrets": "node scripts/check-committed-secrets.mjs"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.11",
    "@cloudflare/workers-types": "^4.20251128.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.55.0"
  },
  "dependencies": {
    "@al-ummah-now/openauth": "1.0.49"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.1",
      "hono": ">=4.12.25"
    }
  }
}
