{
  "name": "al-ummah-now-auth",
  "description": "Deploy an OpenAuth server on Cloudflare Workers.",
  "cloudflare": {
    "label": "OpenAuth Server",
    "products": [
      "Workers",
      "D1",
      "KV"
    ],
    "categories": [],
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ],
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/b2ff10c6-8f7c-419f-8757-e2ccf1c84500/public",
    "dash": true
  },
  "dependencies": {
    "@openauthjs/openauth": "0.3.2",
    "@types/node": "^22.14.1",
    "resend": "^4.2.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "wrangler": "^4.12.0"
  },
  "scripts": {
    "check": "npx wrangler deploy --dry-run",
    "deploy": "npx wrangler deploy --env production",
    "deploy:preview": "npx wrangler deploy --env preview",
    "dev": "npx wrangler dev",
    "dev:preview": "npx wrangler dev --env preview",
    "predeploy": "npx wrangler d1 migrations apply AUTH_DB --remote --env production",
    "types": "npx wrangler types",
    "migrate:preview": "npx wrangler d1 migrations apply AUTH_DB --remote --env preview",
    "test": "npm run check",
    "type-check": "npx tsc --noEmit"
  }
}
