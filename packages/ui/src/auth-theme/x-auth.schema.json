{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auth's extension of a theme package (x-auth)",
  "description": "Sign-in page details beyond the platform format. Other apps ignore it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "$ref": "#/$defs/localized"
    },
    "radius": {
      "enum": [
        "none",
        "sm",
        "md",
        "lg",
        "full"
      ]
    },
    "fontImports": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 500,
        "pattern": "^https://fonts\\.googleapis\\.com/css2?\\?[A-Za-z0-9=:;,@&+%._-]+$"
      },
      "description": "Google Fonts stylesheets."
    },
    "photos": {
      "type": "object",
      "properties": {
        "light": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/imageAsset"
              },
              {
                "type": "string",
                "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9._~/%+=&?-]*$",
                "maxLength": 500
              }
            ]
          }
        },
        "dark": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/imageAsset"
              },
              {
                "type": "string",
                "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9._~/%+=&?-]*$",
                "maxLength": 500
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "light"
      ],
      "description": "Photos behind the sign-in card; one is picked per page."
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "object",
          "description": "Every sign-in page",
          "propertyNames": {
            "enum": [
              "page.backgroundImage",
              "page.text",
              "card.width",
              "card.padding",
              "card.border",
              "card.text",
              "card.blur",
              "card.contentPadding",
              "graphic.display",
              "logo.display",
              "logo.filter",
              "title.text",
              "title.font",
              "title.fontAr",
              "heading.text",
              "heading.font",
              "heading.fontAr",
              "label.text",
              "input.background",
              "input.text",
              "input.border",
              "input.radius",
              "button.background",
              "button.text",
              "button.radius",
              "button.shadow",
              "button.hover",
              "link.text",
              "alert.background",
              "alert.text"
            ]
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/cssValue"
              },
              {
                "type": "object",
                "properties": {
                  "light": {
                    "$ref": "#/$defs/cssValue"
                  },
                  "dark": {
                    "$ref": "#/$defs/cssValue"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "light",
                  "dark"
                ]
              }
            ]
          }
        },
        "signIn": {
          "type": "object",
          "description": "Sign-in",
