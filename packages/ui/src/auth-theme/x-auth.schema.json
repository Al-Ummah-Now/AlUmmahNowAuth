  },
  "$defs": {
    "localized": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "additionalProperties": false,
      "required": [
        "en",
        "ar"
      ]
    },
    "cssValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?![\\s\\S]*(?:url\\(|expression\\(|javascript:|var\\(--(?:fanous|m|r)-))(?:[^;{}<>\\\\@]|\\{(?:(?:color|brand|component|material|radius|spacing)\\.[a-zA-Z0-9.]+|asset:assets/[A-Za-z0-9._/-]+)\\})*$",
      "description": "One CSS value. No ; { } < > \\ @ or url(). Tokens are {color.x}, {brand.x}, {component.part.name}, {material.x}, {radius.x}, {spacing.x}; images are {asset:assets/file.svg}. var() is only for layout variables a component sets (for example var(--from))."
    },
    "imageAsset": {
      "type": "string",
      "pattern": "^assets/(?![\\s\\S]*\\.\\.)[A-Za-z0-9_-][A-Za-z0-9._/-]*\\.(?:svg|png|jpg|jpeg|webp)$"
    }
  }
}
